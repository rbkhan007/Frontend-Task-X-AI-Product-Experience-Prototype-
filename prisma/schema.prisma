generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessRequest {
  id      String   @id @default(cuid())
  name    String
  email   String   @unique
  company String
  role    String
  useCase String
  createdAt DateTime @default(now())
}
